{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "asset/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/tracker", "dest": "/tracker.html" },
    { "src": "/account", "dest": "/account.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
